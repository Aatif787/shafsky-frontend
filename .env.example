# Shafsky Frontend Environment Placeholders

# Backend API
VITE_BACKEND_API_URL=http://127.0.0.1:8003

# Clerk (browser publishable key only). Never put CLERK_SECRET_KEY in a VITE_ variable.
# After Clerk sign-in, the app exchanges the session token at POST /api/auth/clerk-exchange
# and continues to authorize API calls with the FastAPI access JWT.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase (client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (server-side admin - required for admin routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id

# Search Console (HTML-tag method)
# 1. Open https://search.google.com/search-console
# 2. Add properties https://shafskyaviation.com and https://shafskyaviation.in
# 3. Choose "HTML tag", copy the content= value only, paste below, restart the server
# 4. Click Verify, then Sitemaps → submit /sitemap.xml on both properties
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
